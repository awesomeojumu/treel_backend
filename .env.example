# Port & Host configuration (Render automatically injects PORT=10000)
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas Database URI (Replace with your Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT & Authentication Secret Keys
JWT_SECRET=replace_with_strong_random_jwt_secret
REFRESH_TOKEN_SECRET=replace_with_strong_random_refresh_secret

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=https://treel-frontend.vercel.app
